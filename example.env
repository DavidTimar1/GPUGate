# Every setting GPUGate reads, with no values. Copy this file to .env in the project folder,
# fill in what you use, and leave the rest out. A variable already set in the environment wins
# over the same name in .env. Never commit .env.

# RunPod API key. Leave out to not use RunPod.
RUNPOD_API_GPU_GATE=

# Verda client id and client secret. Leave both out to not use Verda.
VERDA_MAIN_CLIENT_ID=
VERDA_MAIN_CLIENT_SECRET=

# Hugging Face token, optional: a machine's model download is authenticated instead of rate limited.
# HF_API_KEY is read first; HF_TOKEN is the fallback name.
HF_API_KEY=
HF_TOKEN=

# Access key for tools that call the fixed address /p/<project> and GET /api/projects. They send it as
# "Authorization: Bearer <key>" or "X-Api-Key: <key>". At least 32 characters, or the program will not
# start: ./dist/gpugate make-key prints a good one. Leave out and those two stay open to anyone who can
# reach a listening address. The console itself is always behind its password (./dist/gpugate set-password).
GPUGATE_ACCESS_KEY=

# Extra names the console may be reached by, comma-separated, for example a name a VPN gives this machine.
# A request addressed to any name that is not a listen address, localhost or one of these is refused.
GPUGATE_HOSTNAMES=

# Set to 1 only when the console sits behind a TLS front, so the login cookie is marked Secure.
GPUGATE_COOKIE_SECURE=

# Addresses the console listens on: a comma-separated list of IP addresses, exactly these and no
# others. Default 127.0.0.1 (this machine only). A hostname, 0.0.0.0 and :: are refused.
# To reach the console from another machine, add that machine's own address, for example a VPN address.
GPUGATE_LISTEN=

# Port for every listen address. Default 8719. If it is taken the program stops; it never picks another.
GPUGATE_PORT=
